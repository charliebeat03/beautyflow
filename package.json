{
  "name": "beautyflow",
  "version": "0.1.0",
  "private": true,
  "main": "backend/dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only backend/src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node backend/dist/index.js",
    "migrate": "ts-node scripts/apply-migrations.ts",
    "cleanup": "ts-node scripts/cleanup-refresh-tokens.ts",
    "test": "pnpm exec vitest run",
    "dev:backend": "pnpm exec ts-node-dev --respawn --transpile-only backend/src/index.ts",
    "build:backend": "pnpm exec tsc -p tsconfig.json",
    "dev:frontend": "pnpm --dir frontend dev",
    "build:frontend": "pnpm --dir frontend build",
    "preview:frontend": "pnpm --dir frontend preview",
    "typecheck:frontend": "pnpm --dir frontend typecheck",
    "check": "pnpm run build:backend && pnpm run typecheck:frontend"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.10.0",
    "socket.io": "^4.7.0",
    "web-push": "^3.6.7",
    "zod": "^3.21.4",
    "bcryptjs": "^2.4.3",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6",
    "vitest": "^0.34.5",
    "@types/express": "^4.17.15",
    "@types/node": "^20.4.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/express-rate-limit": "^5.1.3",
    "@types/pg": "^8.11.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^2.2.0",
    "@types/cors": "^2.8.19"
  },
  "engines": {
    "node": ">=20 <23",
    "pnpm": ">=9 <11"
  }
}